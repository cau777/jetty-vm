[Unit]
Description=orca-proxy (unified VM credential-injection & logging proxy)
After=network-online.target

[Service]
# %h/.orca-proxy/current is a symlink to the active versioned install
# (deploy/install.sh) — this path never changes across upgrades, so the unit
# file itself never needs editing (design ticket #12). proxy_addon.py is
# copied to a stable top-level location within each versioned install for
# the same reason (its real location inside site-packages varies by Python
# version). mitmdump itself embeds the Management API on the same process
# via the addon's running()/done() hooks (ticket #4's "same process"
# decision) — this is the entire deployed service, one unit, one process.
#
# Agent VMs reach it only through the Jetty gateway VM's WireGuard tunnel
# (deploy/jetty-lxd). 10.201.0.1 is the host's address on the LXD uplink
# network jetty-lxd creates; until that bridge exists the bind fails and
# Restart= retries, which also covers LXD bringing it up after boot.
# The key file is created 0600 first so mitmproxy never writes its own.
ExecStartPre=%h/.orca-proxy/current/venv/bin/python -m orca_proxy.tunnel ensure
ExecStart=%h/.orca-proxy/current/venv/bin/mitmdump --mode wireguard:%h/.orca-proxy/wireguard.json@10.201.0.1:51820 --set confdir=%h/.orca-proxy/mitm-confdir -s %h/.orca-proxy/current/proxy_addon.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
