#!/usr/bin/env python3
"""orca-proxy's privileged firewall-sync helper (design ticket #12).

This is the ONLY thing that ever carries elevated network privilege
anywhere in orca-proxy. install.sh compiles this file with Nuitka --
`--standalone`, specifically, not `--onefile`: onefile's bootstrap
self-extracts into a fresh /tmp directory owned by whoever invokes it and
fork+execs the real program from there every run, a second file with no
file capabilities of its own that `setcap` on the outer binary never
reaches, which would silently strip CAP_NET_ADMIN/CAP_NET_RAW before this
script's own code ever ran -- and installs the resulting binary (plus its
linked libpython, both root:root, no group/other write bit) to
/usr/local/sbin/orca-proxy-firewall-sync, with `setcap
cap_net_admin,cap_net_raw+eip` applied to the binary directly. File
capabilities don't attach to a `#!`-scripted file at all, only to a real
ELF -- compiling is what makes `setcap` possible in the first place.
Deliberately a single,
dependency-free, stdlib-only file rather than a package spread across
multiple modules: the whole point of a fixed, root-owned install path is
that nothing this binary executes may be writable by the unprivileged
service account that invokes it, and a single flat file, with zero imports
outside the standard library, is the smallest and most auditable thing that
can satisfy that -- `cat` this one file (pre-compile) and you've reviewed
the entire privileged attack surface.

Not imported by, and does not import from, the `orca_proxy` package --
that package lives in the target user's own venv, which this script must
never touch or depend on. (A prior version resolved this path through that
venv via a stable symlink specifically so upgrades wouldn't need a fresh
grant; that was the bug -- every link in the chain was writable by the same
user the elevated access was granted to, so overwriting the script and
re-running it was a zero-effort escalation. See design.md's "Service
installation and firewall-rule lifecycle" section.) The functions below are
intentionally small enough that duplicating this logic instead of importing
it costs far less than the alternative (a dependency on anything mutable by
the grantee).

Takes the VM list on argv (repeated `--vm NAME=IP`) rather than reading the
sqlite state db itself -- one less dependency (no `sqlite3` import, no
schema knowledge, nothing here touches a file the unprivileged Management
API process is concurrently writing to). Not a narrower trust boundary
than reading the db would be: `--db <path>` was just as much an
unvalidated argv value as `--vm NAME=IP` is, so whoever can already invoke
this setcap'd binary with arbitrary arguments could always point it at a
database of their own choosing -- the actual boundary, unchanged either
way, is "who can execute this file", not what shape its input takes.

Deliberately narrow: given the VM list, rebuild two iptables chains, print
a JSON per-VM status map to stdout. `_raise_ambient_capabilities()` is the
one piece of code this design costs over the old sudoers-based helper: a
`setcap`'d binary's capabilities land in its own effective/permitted set on
exec, but do NOT automatically propagate to a plain child process it execs
(here, `iptables`) -- only capabilities in the *ambient* set survive that
hop, and file capabilities clear the ambient set by default. Raising them
back in, once, before the first `iptables` call, is what makes the child
inherit them. See `deploy/install.sh` for the install-time `setcap` call.

Two dedicated chains, integrity-checked on every call and fully rebuilt
(flushed + repopulated) whenever they have drifted -- never incrementally
patched:

- ORCA_PROXY_NAT (nat table, jumped to from PREROUTING): REDIRECTs each
  registered VM's 80/443 to the local proxy port.
- ORCA_PROXY_FILTER (filter table, jumped to from FORWARD): DROPs the same
  VM/port combinations -- the fail-closed baseline: if the NAT redirect is
  ever missing (a startup race, a reconciliation failure), a registered
  VM's 80/443 traffic is blocked rather than reaching the internet
  unenforced. Once a NAT rule successfully redirects a packet, it takes the
  INPUT path, not FORWARD, so this DROP rule is inert for correctly
  redirected traffic and only fires when redirection failed.
"""

import argparse
import ctypes
import ctypes.util
import json
import os
import re
import subprocess
import sys

NAT_CHAIN = "ORCA_PROXY_NAT"
FILTER_CHAIN = "ORCA_PROXY_FILTER"

# Linux interface names: IFNAMSIZ is 16 bytes including the NUL, so 15
# usable characters; no shell metacharacters permitted. `bridge` reaches
# this module from argv (operator-controlled but *unvalidated* until this
# check) and gets interpolated into `sh -c` strings below -- an unvalidated
# value here is a straight shell-injection-to-capability primitive. Unlike
# the old sudoers design, there is no separate args-pinning layer above
# this one anymore (a setcap'd binary's capability isn't scoped to any
# particular argument list) -- this check is the only thing standing
# between an attacker-controlled --bridge and that primitive.
_BRIDGE_NAME_RE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")

# prctl(2) / capability(7) constants -- no stdlib wrapper for either.
_PR_CAP_AMBIENT = 47
_PR_CAP_AMBIENT_RAISE = 2
_CAP_NET_ADMIN = 12
_CAP_NET_RAW = 13

# capget(2)/capset(2) -- like prctl's ambient operations, glibc gives these
# no wrapper (they're meant to be used via libcap, which this file
# deliberately doesn't depend on -- see the module docstring), so they're
# invoked as raw syscalls. Numbers and struct layout are x86-64/Linux
# specific, consistent with the rest of this file's assumptions.
_SYS_CAPGET = 125
_SYS_CAPSET = 126
_LINUX_CAPABILITY_VERSION_3 = 0x20080522


class _CapHeader(ctypes.Structure):
    _fields_ = [("version", ctypes.c_uint32), ("pid", ctypes.c_int)]


class _CapData(ctypes.Structure):
    _fields_ = [
        ("effective", ctypes.c_uint32),
        ("permitted", ctypes.c_uint32),
        ("inheritable", ctypes.c_uint32),
    ]


def _add_to_own_inheritable_set(libc, caps) -> bool:
    """Copy `caps` into this process's own Inheritable set via capset(2).

    Contrary to what `setcap ...+eip` (see install.sh) suggests, the file's
    `i` bit does NOT put anything into the resulting process's Inheritable
    set on exec -- per capabilities(7)'s execve(2) transition rules,
    P'(inheritable) = P(inheritable), i.e. the Inheritable set is carried
    over from the *caller* completely unchanged; a file's inheritable flag
    only participates in computing the new *Permitted* set
    (P(inheritable) & F(inheritable)). Since the unprivileged process that
    execs this binary (orca-proxy's own service) has an empty Inheritable
    set, this process's Inheritable set is empty too, no matter what
    install.sh's `setcap` flags say -- only Permitted/Effective get
    populated (via F(permitted)/F(effective) against the process's
    bounding set). PR_CAP_AMBIENT_RAISE below requires the capability in
    BOTH Permitted and Inheritable, so without this step it always fails
    with EPERM.

    This is safe without CAP_SETPCAP: capabilities(7)'s rules for capset(2)
    allow a process to add to its own Inheritable set anything already
    present in its own Permitted set, which these are (via setcap's `p`
    flag). This doesn't broaden what this binary can do -- it only lets it
    actually hand capabilities it already legitimately holds to the
    `iptables` children it execs, which was always the intent (see
    `_raise_ambient_capabilities`'s docstring).
    """
    header = _CapHeader(version=_LINUX_CAPABILITY_VERSION_3, pid=0)
    data = (_CapData * 2)()
    if libc.syscall(_SYS_CAPGET, ctypes.byref(header), ctypes.byref(data)) != 0:
        return False
    for cap in caps:
        idx, bit = divmod(cap, 32)
        data[idx].inheritable |= 1 << bit
    header = _CapHeader(version=_LINUX_CAPABILITY_VERSION_3, pid=0)
    return libc.syscall(_SYS_CAPSET, ctypes.byref(header), ctypes.byref(data)) == 0


def _raise_ambient_capabilities() -> None:
    """Propagate CAP_NET_ADMIN/CAP_NET_RAW into the `iptables` children this
    script execs.

    `setcap ...+eip` (see install.sh) puts these capabilities in this
    binary's own effective/permitted sets on exec -- enough for this
    process to make privileged syscalls itself -- but a plain,
    non-privileged child process (`iptables`, no file capabilities of its
    own) only inherits capabilities that are also in the parent's *ambient*
    set, which file capabilities clear by default. Raising them here, once,
    before the first `iptables` call, is what makes that inheritance
    happen. Doing that requires the capability in this process's own
    Inheritable set first -- see `_add_to_own_inheritable_set`.

    Best-effort and non-fatal: if this fails (not actually running from the
    setcap'd binary -- e.g. under test, or a plain source-file invocation),
    the `iptables` calls below will simply fail with their own non-zero
    exit code, which reconcile()/is_in_sync() already turn into an "error"
    status -- the normal, already-tested fail-closed path. There is no
    separate failure mode to handle here.
    """
    libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
    caps = (_CAP_NET_ADMIN, _CAP_NET_RAW)
    if not _add_to_own_inheritable_set(libc, caps):
        errno = ctypes.get_errno()
        print(
            "orca-proxy-firewall-sync: could not add CAP_NET_ADMIN/CAP_NET_RAW to "
            f"this process's own inheritable set ({os.strerror(errno)}); iptables "
            "calls will fail closed if this process isn't already fully privileged",
            file=sys.stderr,
        )
        return
    for cap in caps:
        if libc.prctl(_PR_CAP_AMBIENT, _PR_CAP_AMBIENT_RAISE, cap, 0, 0) != 0:
            errno = ctypes.get_errno()
            print(
                f"orca-proxy-firewall-sync: could not raise CAP {cap} into the ambient "
                f"set ({os.strerror(errno)}); iptables calls will fail closed if this "
                "process isn't already fully privileged",
                file=sys.stderr,
            )
            return


def _parse_vm(value: str) -> tuple[str, str]:
    """argparse `type=` for `--vm NAME=IP` -- `=` can't appear in either a VM
    name or an IPv4 address, so this needs no quoting/escaping convention.
    """
    name, sep, ip = value.partition("=")
    if not sep:
        raise argparse.ArgumentTypeError(f"expected NAME=IP, got {value!r}")
    return (name, ip)


def build_commands(vms: list[tuple[str, str]], bridge: str, proxy_port: int) -> list[list[str]]:
    """Return the full, idempotent sequence of iptables argv commands.

    `vms` is a list of (name, ip_address) pairs -- only the IPs matter here,
    names are accepted for readability/logging by callers.
    """
    if not _BRIDGE_NAME_RE.match(bridge):
        raise ValueError(f"invalid bridge interface name: {bridge!r}")

    commands: list[list[str]] = [
        # Create-if-absent via `sh -c ... || true` (a bare `iptables -N`
        # exits 1 if the chain already exists -- true on every reconcile
        # after the first -- which reconcile() would treat as a fatal
        # abort before ever reaching the -F flush or per-VM rules below),
        # then flush unconditionally -- this is what makes the whole thing
        # an idempotent full rebuild rather than an incremental patch.
        ["sh", "-c", f"iptables -t nat -N {NAT_CHAIN} 2>/dev/null || true"],
        ["iptables", "-t", "nat", "-F", NAT_CHAIN],
        ["sh", "-c", f"iptables -N {FILTER_CHAIN} 2>/dev/null || true"],
        ["iptables", "-F", FILTER_CHAIN],
    ]

    for _name, ip in vms:
        for port in (80, 443):
            commands.append(
                [
                    "iptables", "-t", "nat", "-A", NAT_CHAIN,
                    "-s", ip, "-p", "tcp", "--dport", str(port),
                    "-j", "REDIRECT", "--to-port", str(proxy_port),
                ]
            )
            commands.append(
                [
                    "iptables", "-A", FILTER_CHAIN,
                    "-s", ip, "-p", "tcp", "--dport", str(port), "-j", "DROP",
                ]
            )

    # Hook the chains in, once -- -C checks whether the jump rule already
    # exists (idempotent: skip the -I if so). The FORWARD jump uses -I
    # (insert at position 1) so it's evaluated before Multipass's own
    # bridge ACCEPT rules; the PREROUTING jump position doesn't carry the
    # same risk since REDIRECT only ever narrows traffic, never widens it.
    commands.append(
        [
            "sh", "-c",
            f"iptables -t nat -C PREROUTING -i {bridge} -j {NAT_CHAIN} 2>/dev/null || "
            f"iptables -t nat -A PREROUTING -i {bridge} -j {NAT_CHAIN}",
        ]
    )
    commands.append(
        [
            "sh", "-c",
            f"iptables -C FORWARD -i {bridge} -j {FILTER_CHAIN} 2>/dev/null || "
            f"iptables -I FORWARD 1 -i {bridge} -j {FILTER_CHAIN}",
        ]
    )

    return commands


def reconcile(
    vms: list[tuple[str, str]], bridge: str, proxy_port: int, runner=subprocess.run
) -> dict[str, str]:
    """Run build_commands()'s sequence, returning a per-VM status map.

    Status is "in_sync" for every VM if every command succeeds, or "error"
    for every VM if any command fails (the chains are rebuilt as one unit --
    a partial failure leaves the whole rebuild's success ambiguous per VM,
    so this errs toward reporting all of them as unsynced rather than
    guessing which specific rule failed).
    """
    commands = build_commands(vms, bridge, proxy_port)
    for command in commands:
        result = runner(command, capture_output=True, text=True)
        if result.returncode != 0:
            return {name: "error" for name, _ in vms}
    return {name: "in_sync" for name, _ in vms}


def _rule_count(output: str, chain: str) -> int:
    """Count rules in ``iptables -S <chain>`` output."""
    prefix = f"-A {chain} "
    return sum(1 for line in output.splitlines() if line.startswith(prefix))


def is_in_sync(
    vms: list[tuple[str, str]], bridge: str, proxy_port: int, runner=subprocess.run
) -> bool:
    """Check the complete expected firewall state without changing it.

    The rule-count checks catch stale or duplicate entries while the ``-C``
    checks ensure every expected rule and both parent-chain hooks exist.
    This makes frequent integrity checks cheap and non-disruptive: a full
    flush/rebuild only happens after another firewall manager (notably
    Multipass during boot) actually changes our state.
    """
    if not _BRIDGE_NAME_RE.match(bridge):
        raise ValueError(f"invalid bridge interface name: {bridge!r}")

    checks: list[list[str]] = [
        ["iptables", "-t", "nat", "-C", "PREROUTING", "-i", bridge, "-j", NAT_CHAIN],
        ["iptables", "-C", "FORWARD", "-i", bridge, "-j", FILTER_CHAIN],
    ]
    for _name, ip in vms:
        for port in (80, 443):
            checks.append(
                [
                    "iptables", "-t", "nat", "-C", NAT_CHAIN,
                    "-s", ip, "-p", "tcp", "--dport", str(port),
                    "-j", "REDIRECT", "--to-port", str(proxy_port),
                ]
            )
            checks.append(
                [
                    "iptables", "-C", FILTER_CHAIN,
                    "-s", ip, "-p", "tcp", "--dport", str(port), "-j", "DROP",
                ]
            )

    for command in checks:
        if runner(command, capture_output=True, text=True).returncode != 0:
            return False

    expected_per_chain = len(vms) * 2
    for command, chain in (
        (["iptables", "-t", "nat", "-S", NAT_CHAIN], NAT_CHAIN),
        (["iptables", "-S", FILTER_CHAIN], FILTER_CHAIN),
    ):
        result = runner(command, capture_output=True, text=True)
        if result.returncode != 0 or _rule_count(result.stdout, chain) != expected_per_chain:
            return False

    return True


def ensure_reconciled(
    vms: list[tuple[str, str]], bridge: str, proxy_port: int, runner=subprocess.run
) -> dict[str, str]:
    """Return current status, rebuilding only when the integrity check fails."""
    if is_in_sync(vms, bridge, proxy_port, runner=runner):
        return {name: "in_sync" for name, _ in vms}
    return reconcile(vms, bridge, proxy_port, runner=runner)


def main(argv: list[str] | None = None, runner=subprocess.run) -> int:
    parser = argparse.ArgumentParser(description="Rebuild orca-proxy's per-VM DNAT/DROP rules")
    parser.add_argument(
        "--vm", dest="vms", action="append", default=[], type=_parse_vm, metavar="NAME=IP",
        help="registered VM, repeatable, e.g. --vm skills-dev=10.14.105.22",
    )
    parser.add_argument("--bridge", required=True, help="Multipass bridge interface, e.g. mpqemubr0")
    parser.add_argument("--proxy-port", required=True, type=int)
    args = parser.parse_args(argv)

    _raise_ambient_capabilities()

    status = ensure_reconciled(args.vms, args.bridge, args.proxy_port, runner=runner)
    print(json.dumps(status))
    return 0 if all(v == "in_sync" for v in status.values()) else 1


if __name__ == "__main__":
    sys.exit(main())
